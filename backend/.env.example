# Server Configuration
PORT=5000
NODE_ENV=development

# SMTP Configuration
# Standard SMTP hosts: smtp.gmail.com, smtp.office365.com, smtp.mailgun.org, smtp.sendgrid.net, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Admin Recipient Email
# Inquiries sent from the Contact Us form will be delivered to this address
ADMIN_EMAIL=admin@sldsystem.com

# Optional custom sender name / email header
EMAIL_FROM_NAME="SLD System Support Portal"
EMAIL_FROM_ADDRESS=support@sldsystem.com
