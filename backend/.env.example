# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Specify MONGODB_URI to connect to MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/sld_system

# JWT Authentication Config
JWT_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

# Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS Client Configuration
CLIENT_URL=http://localhost:5173

# Rate Limiter Configurations
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=1000

# SMTP Configuration
# Configure your SMTP credentials below to deliver real emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Admin Recipient Email
# Inquiries submitted through the Contact Us form will be dispatched here
ADMIN_EMAIL=admin@sldsystem.com

EMAIL_FROM_NAME="SLD System Support"
EMAIL_FROM_ADDRESS=support@sldsystem.com
