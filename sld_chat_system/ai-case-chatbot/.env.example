PROJECT_NAME="AI Legal Case Chatbot API"
API_V1_STR="/api/v1"
APP_ENV="development"
ENABLE_DOCS=true

MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="sld_system"
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=120000

# Security
# Set APP_ENV="production", AUTH_ENABLED=true, and provide strong API keys.
# Clients must send X-API-Key.
AUTH_ENABLED=false
API_KEYS=""

# CORS
# Comma-separated list. Do not use "*" in production.
CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# LLMs
LLM_PROVIDER="groq"
LLM_MODEL="llama-3.3-70b-versatile"
GROQ_API_KEY=""
GEMINI_API_KEY=""
